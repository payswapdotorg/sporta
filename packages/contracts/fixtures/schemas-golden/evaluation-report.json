{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "reportId": {
      "type": "string",
      "minLength": 1
    },
    "fixtureSetVersion": {
      "type": "string",
      "minLength": 1
    },
    "benchmarkRunIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "comparison": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "number"
        }
      }
    },
    "recommendation": {
      "type": "string",
      "enum": ["promote", "hold", "reject"]
    },
    "recommendedCandidate": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "decidedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "reportId",
    "fixtureSetVersion",
    "benchmarkRunIds",
    "comparison",
    "recommendation",
    "rationale",
    "decidedAtMs"
  ],
  "additionalProperties": false
}
