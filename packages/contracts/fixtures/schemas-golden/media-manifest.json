{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1
    },
    "sourceAssetId": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byteSize": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "durationMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "frameCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "video": {
      "type": "object",
      "properties": {
        "codec": {
          "type": "string",
          "minLength": 1
        },
        "widthPx": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "heightPx": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "frameRateFps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bitrateKbps": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": ["codec", "widthPx", "heightPx", "frameRateFps"],
      "additionalProperties": false
    },
    "audio": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "codec": {
              "type": "string",
              "minLength": 1
            },
            "channels": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sampleRateHz": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["codec", "channels", "sampleRateHz"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "normalizedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "manifestId",
    "sourceAssetId",
    "contentHash",
    "byteSize",
    "durationMs",
    "frameCount",
    "video",
    "audio",
    "normalizedAtMs"
  ],
  "additionalProperties": false
}
