{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["ok", "failed", "degraded"]
    },
    "outputRef": {
      "type": "string",
      "minLength": 1
    },
    "watermarkAfter": {
      "type": "object",
      "properties": {
        "watermarkMs": {
          "type": "number",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["watermarkMs", "sequence"],
      "additionalProperties": false
    },
    "latencyMs": {
      "type": "number"
    },
    "retryable": {
      "type": "boolean"
    },
    "errorClass": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["sessionId", "stage", "status", "watermarkAfter", "latencyMs", "retryable"],
  "additionalProperties": false
}
