{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "authorized",
        "ingesting",
        "normalizing",
        "processing",
        "rendering",
        "delivering",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "authorizationPolicyId": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["file", "stream"]
          },
          "container": {
            "type": "string",
            "minLength": 1
          },
          "videoStreams": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "audioStreams": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "declaredRightsPolicyId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["sourceId", "kind", "videoStreams", "audioStreams", "declaredRightsPolicyId"],
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "object",
      "properties": {
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "videoClockOffsetMs": {
          "type": "number"
        },
        "audioClockOffsetMs": {
          "type": "number"
        },
        "driftMeasured": {
          "type": "boolean"
        }
      },
      "required": ["durationMs", "videoClockOffsetMs", "audioClockOffsetMs", "driftMeasured"],
      "additionalProperties": false
    },
    "processingState": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "watermark": {
          "type": "object",
          "properties": {
            "watermarkMs": {
              "type": "number",
              "minimum": 0
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["watermarkMs", "sequence"],
          "additionalProperties": false
        },
        "lastError": {
          "type": "string"
        },
        "terminalFailureClass": {
          "type": "string",
          "enum": ["rights-denied", "media-invalid", "resource-limit", "internal"]
        }
      },
      "required": ["stage"],
      "additionalProperties": false
    },
    "createdAtIso": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "cancelledAtIso": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "sessionId",
    "schemaVersion",
    "status",
    "authorizationPolicyId",
    "sources",
    "timeline",
    "processingState",
    "createdAtIso"
  ],
  "additionalProperties": false
}
