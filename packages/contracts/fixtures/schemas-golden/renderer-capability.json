{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rendererId": {
      "type": "string",
      "minLength": 1
    },
    "rendererVersion": {
      "type": "string",
      "minLength": 1
    },
    "rendererClass": {
      "type": "string",
      "enum": ["stylized-video", "procedural-3d", "tactical"]
    },
    "supportedOutputProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resolution": {
            "type": "object",
            "properties": {
              "w": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "h": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": ["w", "h"],
            "additionalProperties": false
          },
          "frameRate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "codec": {
            "type": "string",
            "minLength": 1
          },
          "container": {
            "type": "string",
            "minLength": 1
          },
          "latencyClass": {
            "type": "string",
            "enum": ["offline", "near-live", "live"]
          }
        },
        "required": ["resolution", "frameRate", "codec", "container", "latencyClass"],
        "additionalProperties": false
      }
    },
    "requiresSourceFrames": {
      "type": "boolean"
    },
    "minSnapshotVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "rendererId",
    "rendererVersion",
    "rendererClass",
    "supportedOutputProfiles",
    "requiresSourceFrames",
    "minSnapshotVersion"
  ],
  "additionalProperties": false
}
