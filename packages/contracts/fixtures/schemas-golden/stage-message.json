{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "watermark": {
      "type": "object",
      "properties": {
        "watermarkMs": {
          "type": "number",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["watermarkMs", "sequence"],
      "additionalProperties": false
    },
    "payload": {},
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "resourceBudget": {
      "type": "object",
      "properties": {
        "maxMemoryMb": {
          "type": "number",
          "minimum": 0
        },
        "maxGpuMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "sessionId",
    "schemaVersion",
    "sequence",
    "watermark",
    "payload",
    "correlationId",
    "traceId"
  ],
  "additionalProperties": false
}
