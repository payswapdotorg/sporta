{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byteSize": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "container": {
      "type": "string",
      "minLength": 1
    },
    "durationMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "videoStreamCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "audioStreamCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "declaredRightsPolicyId": {
      "type": "string",
      "minLength": 1
    },
    "uploadState": {
      "type": "string",
      "enum": ["uploading", "uploaded", "stored", "rejected"]
    },
    "uploadedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checksumVerified": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "assetId",
    "contentHash",
    "byteSize",
    "container",
    "durationMs",
    "videoStreamCount",
    "audioStreamCount",
    "declaredRightsPolicyId",
    "uploadState",
    "uploadedAtMs",
    "checksumVerified"
  ],
  "additionalProperties": false
}
