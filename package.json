{
  "name": "sporta",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "test": "bun test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter '@sporta/*' typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@sporta/asr": "workspace:*",
    "@sporta/ball-state": "workspace:*",
    "@sporta/ball-tracking": "workspace:*",
    "@sporta/commentary-segmentation": "workspace:*",
    "@sporta/commentary-understanding": "workspace:*",
    "@sporta/contracts": "workspace:*",
    "@sporta/field-mapping": "workspace:*",
    "@sporta/observability": "workspace:*",
    "@sporta/observation": "workspace:*",
    "@sporta/perception-tracking": "workspace:*",
    "@sporta/session": "workspace:*",
    "@sporta/spatial-state": "workspace:*",
    "@sporta/testing": "workspace:*",
    "@sporta/timeline": "workspace:*",
    "@sporta/world-model": "workspace:*",
    "@types/bun": "^1.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
