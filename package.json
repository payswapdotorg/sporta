  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "^1.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
